{
    "ReverseProxy": {
        "Routes": {
            "products-route": {
                "ClusterId": "product-catalog-cluster",
                "Match": {
                    "Path": "/api/products/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/Products/{**catch-all}"
                    }
                ]
            },
            "inventory-route": {
                "ClusterId": "inventory-cluster",
                "Match": {
                    "Path": "/api/inventory/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/Inventory/{**catch-all}"
                    }
                ]
            },
            "orders-route": {
                "ClusterId": "orders-cluster",
                "Match": {
                    "Path": "/api/orders/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/Orders/{**catch-all}"
                    }
                ]
            },
            "notifications-route": {
                "ClusterId": "notifications-cluster",
                "Match": {
                    "Path": "/api/notifications/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/Notifications/{**catch-all}"
                    }
                ]
            },
            "bff-route": {
                "ClusterId": "bff-cluster",
                "Match": {
                    "Path": "/api/bff/{**catch-all}"
                },
                "Transforms": [
                    {
                        "PathPattern": "/api/bff/{**catch-all}"
                    }
                ]
            }
        },
        "Clusters": {
            "product-catalog-cluster": {
                "LoadBalancingPolicy": "RoundRobin",
                "Destinations": {
                    "product-catalog-1": {
                        "Address": "http://product-catalog-service:8080/"
                    },
                    "product-catalog-2": {
                        "Address": "http://product-catalog-service-replica:8080/"
                    }
                }
            },
            "inventory-cluster": {
                "Destinations": {
                    "inventory": {
                        "Address": "http://inventory-service:8080/"
                    }
                }
            },
            "orders-cluster": {
                "Destinations": {
                    "orders": {
                        "Address": "http://order-service:8080/"
                    }
                }
            },
            "notifications-cluster": {
                "Destinations": {
                    "notifications": {
                        "Address": "http://notification-service:8080/"
                    }
                }
            },
            "bff-cluster": {
                "Destinations": {
                    "bff": {
                        "Address": "http://bff-service:8080/"
                    }
                }
            }
        }
    },
    "AllowedHosts": "*"
}